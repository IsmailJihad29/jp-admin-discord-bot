# Discord Token from Developer Portal
DISCORD_TOKEN=your_discord_bot_token_here

# Groq API Key (for llama-3.3-70b AI grading & !jp assistant)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Google Apps Script Web App URL
DEFAULT_GAS_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
DEFAULT_GAS_SECRET=your_gas_secret_here

# Timezone (Asia/Dhaka for EJP / STRIDE)
DEFAULT_TIMEZONE=Asia/Dhaka
PORT=3000
